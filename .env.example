# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 에서 발급받은 OAuth 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 위와 같은 Client ID를 브라우저(Picker)에서도 씀
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Cloud Console > 사용자 인증 정보 > API 키 (Picker API 호출용, Drive/Sheets API로 제한 권장)
NEXT_PUBLIC_GOOGLE_API_KEY=

# OAuth 콜백 주소 (로컬은 http://localhost:3000, 배포 후 실제 도메인으로 교체하고
# Google Cloud Console의 "승인된 리디렉션 URI"에도 동일하게 등록해야 함)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 학생용 링크에 토큰을 암호화해 담을 때 쓰는 서버 비밀키.
# openssl rand -base64 32 로 생성한 32바이트 키를 넣는다. 절대 공개 저장소에 커밋하지 말 것.
LINK_SECRET_KEY=

# mic-page는 "공용 정적 페이지 하나"로 이 앱의 /mic/index.html에 그대로 배포된다.
# 새 템플릿 시트를 만들 때 "환경설정" 탭에 자동으로 채워 넣을 값 (교사가 나중에 직접 바꿔도 됨)
NEXT_PUBLIC_MIC_PAGE_URL=http://localhost:3000/mic/index.html
NEXT_PUBLIC_MIC_PAGE_ORIGIN=http://localhost:3000
